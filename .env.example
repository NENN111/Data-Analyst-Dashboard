# Для локальной разработки скопируйте файл в .env.
# На Render переменную DATABASE_URL передаёт сервис PostgreSQL.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/vacancies_analytics

# OAuth2 access token активированного приложения https://career.habr.com/profile/applications
HABR_CAREER_ACCESS_TOKEN=

# Secret key зарегистрированного приложения https://api.superjob.ru/
SUPERJOB_API_KEY=
